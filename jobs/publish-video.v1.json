{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://contracts.jieun.studio/jobs/publish-video.v1.json",
  "title": "PublishVideoTask",
  "description": "Payload of the publish:video asynq task. See api/API-PUBLISHER.md §5.",
  "type": "object",
  "required": ["job_id", "trace_id", "user_id", "idempotency_key", "payload"],
  "properties": {
    "job_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "user_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["distribution_id", "account_id", "platform", "object_key", "caption", "video_meta"],
      "properties": {
        "distribution_id": { "type": "string" },
        "account_id": { "type": "string" },
        "platform": { "type": "string", "enum": ["youtube", "tiktok", "instagram", "facebook"] },
        "object_key": { "type": "string" },
        "caption": {
          "type": "object",
          "required": ["title", "description", "tags", "visibility"],
          "properties": {
            "title": { "type": "string", "maxLength": 100 },
            "description": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "visibility": { "type": "string", "enum": ["public", "unlisted", "private"] }
          }
        },
        "video_meta": {
          "type": "object",
          "required": ["duration_ms", "ratio", "size_bytes"],
          "properties": {
            "duration_ms": { "type": "integer", "minimum": 0 },
            "ratio": { "type": "string" },
            "size_bytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
