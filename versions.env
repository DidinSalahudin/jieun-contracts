# Single source of truth for CI tool versions — ARCHITECTURE.md §3.6.
# Loaded into $GITHUB_ENV by jieun-contracts/.github/workflows/reusable-ci-*.yml.
#
# POSTGRES_VERSION/REDIS_VERSION are documentation-only for the Go
# workflow's `services:` block — GitHub Actions starts service containers
# before any step (including the one that loads this file) runs, so that
# block hardcodes postgres:16/redis:7 directly and must be updated by hand
# if these two values ever change here.
GO_VERSION=1.25.0
NODE_VERSION=22
BUN_VERSION=1.2.2
POSTGRES_VERSION=16
REDIS_VERSION=7
# MINIO_VERSION is documentation-only, same reason as POSTGRES_VERSION/
# REDIS_VERSION above — the `services:` block starts before this file is
# loaded, so reusable-ci-go.yml's minio image tag is hardcoded and must
# be updated by hand if this value ever changes.
MINIO_VERSION=latest
