{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://contracts.jieun.studio/events/analysis-completed.v1.json",
  "title": "AnalysisCompletedEvent",
  "description": "data payload of jieun.analysis.completed. See api/API-ANALYZER.md §6.",
  "type": "object",
  "required": ["video_id", "run_id", "duration_ms", "candidates", "transcript_ref", "cost", "engines_used"],
  "properties": {
    "video_id": { "type": "string" },
    "run_id": { "type": "string" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "start_ms", "end_ms", "score", "hook", "signals", "reason"],
        "properties": {
          "candidate_id": { "type": "string" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "hook": { "type": "string" },
          "signals": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    },
    "transcript_ref": { "type": "string" },
    "cost": {
      "type": "object",
      "required": ["transcribe_s", "llm_tokens", "idr"],
      "properties": {
        "transcribe_s": { "type": "integer", "minimum": 0 },
        "llm_tokens": { "type": "integer", "minimum": 0 },
        "idr": { "type": "integer", "minimum": 0 }
      }
    },
    "engines_used": {
      "type": "object",
      "required": ["transcribe", "llm"],
      "properties": {
        "transcribe": { "type": "string" },
        "llm": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
